# LiteAPI key. Sandbox keys start with sand_ or sandbox_, production keys with prod_.
# Get yours at https://dashboard.liteapi.travel  (never commit the real .env file)
LITEAPI_KEY=

MONGODB_URI=mongodb://127.0.0.1:27017/hotel_platform
PORT=4000

# Where the React app runs (CORS). Vite dev server default:
CLIENT_ORIGIN=http://localhost:5173
# Public base URL of the site; used for the payment return URL
PUBLIC_URL=http://localhost:5173

# Your commission as a percentage added to net rates (e.g. 10). Leave empty to use your LiteAPI account default.
# Selling below the hotel's suggested selling price on a public site can be a rate violation: see README.
COMMISSION_MARGIN=

BUSINESS_NAME=Aurelia Stays
